Timeline Canvas =
/* =====================================================================
   MILESTONE IMPACT TIMELINE · CANVAS FRAME (HTML Content visual)
   ---------------------------------------------------------------------
   Frame   : 1245 × 550 px (unchanged)
   Slot    : visual area left 14 · right 14 · top 68 · bottom 14 (unchanged)
             → the Milestone Impact Simulator visual sits on top of it
   Style   : PMIS palette · same header system as the flip cards
             (navy tile · eyebrow 8 px · title 17 px · chips 7.5 px)
             · no top colour accent
   ===================================================================== */
VAR _cInk   = "#1C3A5E"
VAR _cNavy  = "#243761"
VAR _cText  = "#6B7785"
VAR _cMuted = "#8A9099"
VAR _cLine  = "#E6EBF1"
VAR _cSoft  = "#F6F8FB"
VAR _cSlate = "#56698F"
VAR _cSim   = "#0F9B80"
VAR _iTime  = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M3 12h18'/><circle cx='7' cy='12' r='2.2'/><path d='M13 9.5l2.5 2.5-2.5 2.5-2.5-2.5z'/><circle cx='19' cy='12' r='1.6'/><path d='M7 5v2.5'/><path d='M13 4v3'/><path d='M19 16.5V19'/></svg>"
RETURN
"<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;height:100%;overflow:hidden;background:transparent;font-family:'Segoe UI',Arial,sans-serif;font-variant-numeric:tabular-nums}
.tc{position:relative;width:1245px;height:550px;overflow:hidden;color:" & _cInk & ";background:#FFFFFF;border:1px solid " & _cLine & ";border-radius:14px;box-shadow:0 4px 14px rgba(28,58,94,.05)}

/* header */
.hd{position:absolute;left:22px;right:22px;top:12px;height:46px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid " & _cLine & ";padding-bottom:10px}
.lf{display:flex;align-items:center;gap:10px}
.tile{width:34px;height:34px;border-radius:9px;background:" & _cNavy & ";color:#FFFFFF;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 10px rgba(36,55,97,.22)}
.tile svg{width:18px;height:18px}
.eb{font-size:8px;font-weight:700;letter-spacing:.16em;color:" & _cMuted & ";text-transform:uppercase;white-space:nowrap}
.tt{margin-top:3px;font-size:17px;line-height:1.1;font-weight:700;letter-spacing:-.02em;color:" & _cInk & ";white-space:nowrap}
.tt span{color:" & _cSlate & ";font-weight:600}

/* right : series key */
.rt{display:flex;align-items:center;gap:6px}
.rt .lb{margin-right:4px;font-size:7.5px;font-weight:700;letter-spacing:.12em;color:" & _cMuted & ";text-transform:uppercase}
.chip{display:inline-flex;align-items:center;gap:5px;height:20px;padding:0 9px;border-radius:999px;background:" & _cSoft & ";border:1px solid " & _cLine & ";font-size:7.5px;font-weight:700;letter-spacing:.05em;color:" & _cInk & ";text-transform:uppercase;white-space:nowrap}
.k-bl{width:8px;height:8px;border-radius:50%;border:2px solid " & _cSlate & ";background:#FFFFFF}
.k-cu{width:7px;height:7px;border:2px solid " & _cSlate & ";transform:rotate(45deg);background:#FFFFFF}
.k-si{width:9px;height:9px;border-radius:50%;border:2px solid " & _cSim & ";box-shadow:inset 0 0 0 1.5px #FFFFFF;background:" & _cSim & "}

/* slot for the simulator visual */
.va{position:absolute;left:14px;right:14px;top:68px;bottom:14px;background:#FFFFFF;border:1px solid " & _cLine & ";border-radius:11px}
</style>

<div class='tc'>
 <div class='hd'>
  <div class='lf'>
   <div class='tile'>" & _iTime & "</div>
   <div>
    <div class='eb'>Project Control · Schedule Simulation</div>
    <div class='tt'>Milestone Impact Timeline</div>
   </div>
  </div>
  <div class='rt'>
   <span class='lb'>Series</span>
   <span class='chip'><i class='k-bl'></i>Baseline</span>
   <span class='chip'><i class='k-cu'></i>Current</span>
   <span class='chip'><i class='k-si'></i>Simulation</span>
  </div>
 </div>
 <div class='va'></div>
</div>"
