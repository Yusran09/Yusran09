Page_Navigator_HTML Engineering =
/* =====================================================================
   PMIS PAGE NAVIGATOR  ·  HTML Content visual (left rail)
   ---------------------------------------------------------------------
   Reuse   : copy this measure per page and change _ActivePage only
   Keys    : SUMMARY · ENG_OVERVIEW · ENG_TREND · ENG_DELIV · ENG_DOCS
             PROC · CONST · SCHED · CPM · MILE · DELAY · WLA · EVM
             CHANGE · RISK
   Icons   : inline SVG (no external images, crisp at any zoom)
   Divider : 1 px rail on the right edge separates nav from the canvas
   Note    : page switching itself is done by Power BI page-navigation
             buttons placed over the items (HTML visuals cannot navigate)
   ===================================================================== */

-- 1. CONFIG ---------------------------------------------------------------
VAR _ActivePage = "ENG_OVERVIEW"
VAR _AppName    = "PMIS Dashboard"
VAR _AppSub     = "Project Controls"
VAR _Version    = "PMIS · v1.0"

-- 2. PALETTE (matches PMIS dashboard) -------------------------------------
VAR _cInk    = "#1C3A5E"
VAR _cNavy   = "#243761"
VAR _cText   = "#5F6C7B"
VAR _cMuted  = "#9AA3AD"
VAR _cLine   = "#E6EBF1"
VAR _cHover  = "#F5F7FA"
VAR _cActive = "#EEF2F8"
VAR _cGood   = "#0F9B80"

-- 3. ICONS (24x24, stroke = currentColor) --------------------------------
VAR _S = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'>"
VAR _iLogo   = "<svg viewBox='0 0 24 24' fill='none' stroke='#FFFFFF' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M4 19V9'/><path d='M10 19V5'/><path d='M16 19v-7'/><path d='M22 19H2'/></svg>"
VAR _iSum    = _S & "<rect x='3' y='3' width='7' height='7' rx='1.5'/><rect x='14' y='3' width='7' height='7' rx='1.5'/><rect x='3' y='14' width='7' height='7' rx='1.5'/><rect x='14' y='14' width='7' height='7' rx='1.5'/></svg>"
VAR _iEng    = _S & "<circle cx='12' cy='6' r='2'/><path d='M11 7.8L6 20'/><path d='M13 7.8L18 20'/><path d='M7.6 15.5h8.8'/></svg>"
VAR _iProc   = _S & "<path d='M21 8l-9-5-9 5 9 5 9-5z'/><path d='M3 8v8l9 5 9-5V8'/><path d='M12 13v8'/></svg>"
VAR _iCons   = _S & "<path d='M5 17a7 7 0 0 1 14 0'/><path d='M10 10.2V7h4v3.2'/><path d='M3 17h18'/><path d='M4 20h16'/></svg>"
VAR _iSched  = _S & "<path d='M3 3v18'/><path d='M6 6h8'/><path d='M9 12h10'/><path d='M7 18h7'/></svg>"
VAR _iCPM    = _S & "<circle cx='5' cy='12' r='2'/><circle cx='12' cy='5' r='2'/><circle cx='19' cy='12' r='2'/><path d='M6.4 10.6l4.2-4.2'/><path d='M13.4 6.4l4.2 4.2'/><path d='M7 12h10'/></svg>"
VAR _iMile   = _S & "<path d='M12 3l4 4-4 4-4-4z'/><path d='M12 11v8'/><path d='M8 21h8'/></svg>"
VAR _iDelay  = _S & "<circle cx='12' cy='13' r='8'/><path d='M12 9v4l2.5 2.5'/><path d='M9 2h6'/></svg>"
VAR _iWLA    = _S & "<rect x='3' y='5' width='18' height='16' rx='2'/><path d='M3 10h18'/><path d='M8 3v4'/><path d='M16 3v4'/><path d='M7 14.5h10'/></svg>"
VAR _iEVM    = _S & "<path d='M3 20h18'/><path d='M5 16l4-5 4 3 6-8'/><path d='M15.5 6H19v3.5'/></svg>"
VAR _iChange = _S & "<path d='M16 3h5v5'/><path d='M4 20L21 3'/><path d='M21 16v5h-5'/><path d='M15 15l6 6'/><path d='M4 4l5 5'/></svg>"
VAR _iRisk   = _S & "<path d='M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z'/><path d='M12 8v5'/><circle cx='12' cy='16.3' r='.5' fill='currentColor'/></svg>"
VAR _iDown   = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M6 9l6 6 6-6'/></svg>"
VAR _iRight  = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M9 6l6 6-6 6'/></svg>"

-- 4. STATE ----------------------------------------------------------------
VAR _EngOpen = LEFT ( _ActivePage, 4 ) = "ENG_"
VAR _on  = " on"

-- 5. HTML -----------------------------------------------------------------
RETURN
"<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;height:100%;overflow:hidden;background:transparent!important;font-family:'Segoe UI',Arial,sans-serif}
.nav{position:relative;display:flex;flex-direction:column;width:100%;height:100%;min-height:600px;padding:14px 14px 12px 10px;background:#FFFFFF}
.nav:after{content:'';position:absolute;top:0;bottom:0;right:0;width:1px;background:" & _cLine & "}
.nav:before{content:'';position:absolute;top:0;bottom:0;right:1px;width:10px;background:linear-gradient(90deg,rgba(28,58,94,0),rgba(28,58,94,.035))}

/* brand */
.brand{display:flex;align-items:center;gap:10px;padding:2px 6px 14px;border-bottom:1px solid " & _cLine & ";flex-shrink:0}
.logo{width:32px;height:32px;flex-shrink:0;border-radius:9px;background:" & _cNavy & ";display:flex;align-items:center;justify-content:center;box-shadow:0 3px 8px rgba(36,55,97,.25)}
.logo svg{width:17px;height:17px}
.bn{font-size:12.5px;font-weight:700;letter-spacing:-.01em;color:" & _cInk & ";white-space:nowrap}
.bs{margin-top:2px;font-size:8.5px;color:" & _cMuted & ";white-space:nowrap}

/* menu */
.menu{flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;padding:4px 2px 8px 0}
.menu::-webkit-scrollbar{width:3px}.menu::-webkit-scrollbar-thumb{background:" & _cLine & ";border-radius:3px}
.sec{margin:14px 0 5px 10px;font-size:7.5px;font-weight:700;letter-spacing:.14em;color:" & _cMuted & ";text-transform:uppercase}
.it{position:relative;display:flex;align-items:center;gap:10px;height:32px;padding:0 8px 0 10px;margin-bottom:1px;border-radius:8px;color:" & _cText & ";cursor:pointer;transition:background .16s ease,color .16s ease}
.it:hover{background:" & _cHover & ";color:" & _cInk & "}
.it svg{width:17px;height:17px;flex-shrink:0}
.lb{flex:1;min-width:0;font-size:10.5px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chev{width:11px;height:11px;flex-shrink:0;color:#B7C0CA}
.chev svg{width:11px;height:11px}
.it.on{background:" & _cActive & ";color:" & _cInk & "}
.it.on .lb{font-weight:700}
.it.on:before{content:'';position:absolute;left:0;top:8px;bottom:8px;width:3px;border-radius:0 3px 3px 0;background:" & _cNavy & "}
.it.grp{color:" & _cInk & "}.it.grp .lb{font-weight:700}.it.grp .chev{color:" & _cInk & "}

/* sub menu (tree) */
.sub{position:relative;margin:2px 0 6px 18px;padding-left:12px}
.sub:before{content:'';position:absolute;left:0;top:2px;bottom:14px;width:1px;background:" & _cLine & "}
.si{position:relative;display:flex;align-items:center;gap:8px;height:27px;padding:0 8px;margin-bottom:1px;border-radius:7px;font-size:9.8px;font-weight:500;color:" & _cText & ";cursor:pointer;transition:background .16s ease,color .16s ease}
.si:before{content:'';position:absolute;left:-12px;top:50%;width:9px;height:1px;background:" & _cLine & "}
.si i{width:5px;height:5px;border-radius:50%;border:1.3px solid #B7C0CA;flex-shrink:0}
.si:hover{background:" & _cHover & ";color:" & _cInk & "}
.si.on{background:" & _cActive & ";color:" & _cInk & ";font-weight:700}
.si.on:before{background:" & _cNavy & "}
.si.on i{background:" & _cNavy & ";border-color:" & _cNavy & "}

/* context card */
.ctx{flex-shrink:0;margin-top:8px;padding:12px 12px 11px;border:1px solid " & _cLine & ";border-radius:11px;background:linear-gradient(160deg,#FAFBFD 0%,#F4F7FA 100%)}
.ck{display:flex;align-items:center;gap:6px;font-size:7px;font-weight:700;letter-spacing:.14em;color:" & _cMuted & ";text-transform:uppercase}
.ck i{width:6px;height:6px;border-radius:50%;background:" & _cGood & ";box-shadow:0 0 0 3px rgba(15,155,128,.12)}
.ct{margin-top:8px;font-size:12px;line-height:1.25;font-weight:700;color:" & _cInk & "}
.cs{margin-top:3px;font-size:8.5px;line-height:1.35;color:" & _cText & "}
.steps{position:relative;display:flex;justify-content:space-between;margin-top:13px}
.steps:before{content:'';position:absolute;left:4px;right:4px;top:3.5px;height:1px;background:#D5DCE5}
.st{position:relative;display:flex;justify-content:center;width:20%}
.st:first-child{justify-content:flex-start}.st:last-child{justify-content:flex-end}
.st b{width:8px;height:8px;border-radius:50%;background:#FFFFFF;border:1.5px solid #B7C0CA}
.scap{display:flex;justify-content:space-between;margin-top:7px;font-size:7.5px;color:" & _cMuted & "}.scap b{color:" & _cInk & ";font-weight:700}
.st.on b{background:" & _cNavy & ";border-color:" & _cNavy & "}
.foot{flex-shrink:0;display:flex;justify-content:space-between;margin-top:9px;padding:0 4px;font-size:7px;font-weight:600;letter-spacing:.06em;color:#B0B8C2}
</style>

<div class='nav'>

 <div class='brand'>
  <div class='logo'>" & _iLogo & "</div>
  <div><div class='bn'>" & _AppName & "</div><div class='bs'>" & _AppSub & "</div></div>
 </div>

 <div class='menu'>

  <div class='sec'>Overview</div>
  <div class='it" & IF ( _ActivePage = "SUMMARY", _on ) & "'>" & _iSum & "<span class='lb'>Progress Summary</span></div>

  <div class='sec'>EPC Progress</div>
  <div class='it" & IF ( _EngOpen, " grp" ) & "'>" & _iEng & "<span class='lb'>Engineering</span><span class='chev'>" & IF ( _EngOpen, _iDown, _iRight ) & "</span></div>
  " & IF ( _EngOpen,
  "<div class='sub'>
   <div class='si" & IF ( _ActivePage = "ENG_OVERVIEW", _on ) & "'><i></i>Overview</div>
   <div class='si" & IF ( _ActivePage = "ENG_TREND", _on ) & "'><i></i>Progress Trend</div>
   <div class='si" & IF ( _ActivePage = "ENG_DELIV", _on ) & "'><i></i>Deliverables</div>
   <div class='si" & IF ( _ActivePage = "ENG_DOCS", _on ) & "'><i></i>Documents</div>
  </div>" ) & "
  <div class='it" & IF ( _ActivePage = "PROC", _on ) & "'>" & _iProc & "<span class='lb'>Procurement</span><span class='chev'>" & _iRight & "</span></div>
  <div class='it" & IF ( _ActivePage = "CONST", _on ) & "'>" & _iCons & "<span class='lb'>Construction</span><span class='chev'>" & _iRight & "</span></div>

  <div class='sec'>Schedule</div>
  <div class='it" & IF ( _ActivePage = "SCHED", _on ) & "'>" & _iSched & "<span class='lb'>Schedule Performance</span></div>
  <div class='it" & IF ( _ActivePage = "CPM", _on ) & "'>" & _iCPM & "<span class='lb'>Critical Path Monitoring</span></div>
  <div class='it" & IF ( _ActivePage = "MILE", _on ) & "'>" & _iMile & "<span class='lb'>Milestone Monitoring</span></div>
  <div class='it" & IF ( _ActivePage = "DELAY", _on ) & "'>" & _iDelay & "<span class='lb'>Delay Analysis</span></div>
  <div class='it" & IF ( _ActivePage = "WLA", _on ) & "'>" & _iWLA & "<span class='lb'>3-Week Look Ahead</span></div>

  <div class='sec'>Cost</div>
  <div class='it" & IF ( _ActivePage = "EVM", _on ) & "'>" & _iEVM & "<span class='lb'>Earned Value (EVM)</span></div>
  <div class='it" & IF ( _ActivePage = "CHANGE", _on ) & "'>" & _iChange & "<span class='lb'>Change Management</span></div>

  <div class='sec'>Risk</div>
  <div class='it" & IF ( _ActivePage = "RISK", _on ) & "'>" & _iRisk & "<span class='lb'>Risk &amp; Opportunity</span></div>

 </div>

 <div class='ctx'>
  <div class='ck'><i></i>Engineering Intelligence</div>
  <div class='ct'>From progress to performance</div>
  <div class='cs'>Turning engineering data into actionable project insight.</div>
  <div class='steps'>
   <div class='st on'><b></b></div>
   <div class='st'><b></b></div>
   <div class='st'><b></b></div>
   <div class='st'><b></b></div>
   <div class='st'><b></b></div>
  </div>
  <div class='scap'><span>Step 1 of 5 · analysis flow</span><b>Progress</b></div>
 </div>

 <div class='foot'><span>" & _Version & "</span><span>PROJECT CONTROLS</span></div>

</div>"
