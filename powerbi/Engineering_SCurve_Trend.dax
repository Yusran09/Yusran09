Engineering S-Curve Trend =
/* =====================================================================
   ENGINEERING S-CURVE TREND  ·  HTML Content visual
   ---------------------------------------------------------------------
   Measures   : [ENG Periodic Plan] [ENG Periodic Actual]  (weight per reporting date)
   X-axis     : true time scale on each reporting date in 'S-Curve Engineering'[Date]
                (monthly, bi-monthly or irregular periods — no zero-filled gaps)
   Cumulative : opening balance + running sum of periodic  (Σ periodic = S-curve)
   Normalise  : TRUE  -> % of the FILTERED scope (EV / scope BAC): every Area,
                         Discipline or Work Package gets its own 0–100 % S-curve
                FALSE -> weighted contribution to the overall project
   Cut-off    : [PMIS Cut-Off Date] — same measure as the page header.
                Actual = cumulative to the last reporting date <= cut-off;
                Plan   = plan curve interpolated AT the cut-off date (PV @ status date)
   Status     : ON PLAN >= 0 pts · MONITOR to _VarWatch · AT RISK below
                (same rule as the Discipline Performance matrix)
   Reuse      : change the CONFIG vars + 2 measures for PROC / CONST
   ===================================================================== */

-- 1. CONFIG ------------------------------------------------------------
VAR _Badge     = "ENGINEERING"
VAR _Title     = "Engineering S-Curve"
VAR _Normalize = TRUE ()
VAR _CutOff    = [PMIS Cut-Off Date]
VAR _VarWatch  = -0.02          -- variance below this = AT RISK (fraction)
VAR _Subtitle  =
    IF ( _Normalize,
        "Cumulative physical progress · % of selected scope",
        "Cumulative physical progress · weighted to overall project" )

-- PALETTE (matches PMIS dashboard) ---------------------------------------
VAR _cInk      = "#1C3A5E"   -- titles, values
VAR _cNavy     = "#243761"   -- badge / brand navy
VAR _cText     = "#6B7785"   -- subtitle, year labels
VAR _cMuted    = "#8A9099"   -- secondary text
VAR _cAxis     = "#9AA3AD"   -- axis labels
VAR _cGrid     = "#EDF0F4"   -- gridlines
VAR _cSep      = "#E1E6EC"   -- year separators
VAR _cActLine  = "#EB666B"   -- Earned / Actual cumulative
VAR _cPlanLine = "#22A9D8"   -- Planned cumulative
VAR _cActBar   = "#56698F"   -- Earned / Actual periodic
VAR _cPlanBar  = "#8AC1BD"   -- Planned periodic
VAR _cGood     = "#0F9B80"   -- on / ahead of plan
VAR _cWarn     = "#E39016"   -- slightly behind
VAR _cBad      = "#D65365"   -- behind plan

-- 2. DATA ---------------------------------------------------------------
-- Every date is evaluated with Area / Discipline / WP filters kept, date filter replaced
VAR _Visible =
    FILTER ( VALUES ( 'S-Curve Engineering'[Date] ), NOT ISBLANK ( 'S-Curve Engineering'[Date] ) )
VAR _All =
    ADDCOLUMNS (
        FILTER ( ALL ( 'S-Curve Engineering'[Date] ), NOT ISBLANK ( 'S-Curve Engineering'[Date] ) ),
        "@PP", [ENG Periodic Plan],
        "@AP", [ENG Periodic Actual]
    )
VAR _Data =
    FILTER (
        _All,
        'S-Curve Engineering'[Date] IN _Visible
            && NOT ( ISBLANK ( [@PP] ) && ISBLANK ( [@AP] ) )
    )
VAR _Count = COUNTROWS ( _Data )
VAR _First = MINX ( _Data, 'S-Curve Engineering'[Date] )
VAR _Open  = FILTER ( _All, 'S-Curve Engineering'[Date] < _First )   -- progress before a date-slicer window

-- 3. SCALE --------------------------------------------------------------
VAR _TotPP  = SUMX ( _All, [@PP] )                                     -- scope BAC (plan weight)
VAR _ProjPP =
    CALCULATE (
        SUMX ( FILTER ( VALUES ( 'S-Curve Engineering'[Date] ), NOT ISBLANK ( 'S-Curve Engineering'[Date] ) ), [ENG Periodic Plan] ),
        REMOVEFILTERS ()
    )                                                                   -- project BAC
-- JS receives integers = % x 10,000 (locale-safe, no decimal separator)
VAR _Scale =
    IF ( _Normalize,
        DIVIDE ( 1000000, _TotPP ),
        IF ( _ProjPP > 1.5, 10000, 1000000 ) )                          -- percent vs fraction units
VAR _Wt = FORMAT ( COALESCE ( ROUND ( DIVIDE ( _TotPP, _ProjPP ) * 1000, 0 ), 1000 ), "0" )

-- 4. SERIALISE TO JS ARRAYS ---------------------------------------------
VAR _D  = CONCATENATEX ( _Data, FORMAT ( YEAR ( 'S-Curve Engineering'[Date] ) * 10000 + MONTH ( 'S-Curve Engineering'[Date] ) * 100 + DAY ( 'S-Curve Engineering'[Date] ), "0" ), ",", 'S-Curve Engineering'[Date], ASC )
VAR _PP = CONCATENATEX ( _Data, FORMAT ( COALESCE ( ROUND ( [@PP] * _Scale, 0 ), 0 ), "0" ), ",", 'S-Curve Engineering'[Date], ASC )
VAR _AP = CONCATENATEX ( _Data, FORMAT ( COALESCE ( ROUND ( [@AP] * _Scale, 0 ), 0 ), "0" ), ",", 'S-Curve Engineering'[Date], ASC )
VAR _O  =
    FORMAT ( COALESCE ( ROUND ( SUMX ( _Open, [@PP] ) * _Scale, 0 ), 0 ), "0" ) & ","
        & FORMAT ( COALESCE ( ROUND ( SUMX ( _Open, [@AP] ) * _Scale, 0 ), 0 ), "0" )

VAR _CO = FORMAT ( YEAR ( _CutOff ) * 10000 + MONTH ( _CutOff ) * 100 + DAY ( _CutOff ), "0" )
VAR _VW = FORMAT ( _VarWatch * 10000, "0" )     -- pts x 100, locale-safe

-- 5. HTML ---------------------------------------------------------------
VAR _Html =
"<!DOCTYPE html><html><head><meta charset='utf-8'>
<link href='https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&display=swap' rel='stylesheet'>
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{overflow:hidden;height:100vh;width:100%;background:transparent!important;font-family:'Jost',system-ui,sans-serif;color:" & _cInk & "}
.tc{width:100%;height:100vh;display:flex;flex-direction:column;overflow:hidden;background:#FFFFFF;border:1px solid " & _cGrid & ";border-radius:14px;box-shadow:0 4px 14px rgba(28,58,94,.045)}
.hdr{padding:16px 20px 4px;flex-shrink:0;display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.badge{display:inline-flex;align-items:center;gap:5px;background:" & _cNavy & "14;padding:3px 10px;border-radius:999px;margin-bottom:4px}
.badge span{font-size:9px;font-weight:500;letter-spacing:2px;color:" & _cNavy & "}
.ttl{font-size:16px;font-weight:600;color:" & _cInk & "}
.sub{font-size:11px;font-weight:300;color:" & _cText & ";margin-top:1px}
.kpi{display:flex;align-items:center;gap:6px;margin-top:8px;flex-wrap:wrap}
.pill{display:flex;align-items:center;gap:3px;padding:3px 9px;border-radius:20px}
.pill span{font-size:12px;font-weight:600}
.k-l{font-size:11px;font-weight:300;color:" & _cMuted & "}
.k-v{font-size:11px;font-weight:600;color:" & _cInk & "}
.k-r{font-size:10px;font-weight:300;color:" & _cMuted & "}
.rgt{display:flex;flex-direction:column;align-items:flex-end;gap:5px;flex-shrink:0}
.dd{font-size:8px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:" & _cMuted & "}
.chip{display:flex;align-items:center;gap:6px;padding:3px 9px;border-radius:999px}
.chip b{font-size:11px;font-weight:600}
.chip i{font-style:normal;font-size:8px;font-weight:600;letter-spacing:1.2px}
.mth{font-size:9px;font-weight:300;color:" & _cMuted & "}
.mth b{font-weight:600;color:" & _cInk & "}
.lg{display:flex;align-items:center;gap:9px;margin-top:4px}
.lg span{display:inline-flex;align-items:center;gap:4px;font-size:7.5px;font-weight:500;color:" & _cInk & ";letter-spacing:0.4px}
.lg em{display:inline-block}
.chart{flex:1;position:relative;min-height:0}
.chart svg{width:100%;height:100%;display:block}
.yr{font-size:8.5px;fill:" & _cMuted & ";text-anchor:middle}
.yy{font-size:11px;font-weight:600;fill:" & _cText & ";text-anchor:middle}
.ax{font-size:8.5px;fill:" & _cAxis & "}
.grid{stroke:" & _cGrid & ";stroke-width:0.6}
.halo{paint-order:stroke;stroke:rgba(255,255,255,.9);stroke-width:3px;stroke-linejoin:round}
.fade{opacity:0;animation:fadeIn .4s ease .8s forwards}
.pulse{animation:pulse 2s ease-in-out 1.2s infinite}
@keyframes fadeIn{to{opacity:1}}
@keyframes pulse{0%,100%{opacity:.3;r:7}50%{opacity:.65;r:10}}
#tip{position:absolute;pointer-events:none;opacity:0;transition:opacity .15s ease;background:rgba(255,255,255,.96);backdrop-filter:blur(8px);border-radius:10px;padding:8px 11px;box-shadow:0 2px 12px rgba(28,58,94,.12);border:1px solid rgba(28,58,94,.10);min-width:160px;z-index:5}
#tip .h{font-size:11px;font-weight:600;color:" & _cInk & "}
#tip .pd{font-size:8px;font-weight:300;color:" & _cAxis & ";margin:1px 0 5px}
#tip .r{display:flex;align-items:center;gap:6px;font-size:9.5px;color:" & _cMuted & ";margin-top:2px}
#tip .r b{margin-left:auto;font-weight:600;color:" & _cInk & "}
#tip .sw{display:inline-block;width:10px;height:2px;border-radius:1px}
#tip .sa{background:" & _cActLine & ";height:3px}
#tip .sp{background:" & _cPlanLine & "}
#tip .ba{background:" & _cActBar & ";width:6px;height:8px}
#tip .bp{background:" & _cPlanBar & ";width:6px;height:8px}
#tip .hr{height:1px;background:" & _cGrid & ";margin:5px 0}
#tip .fc{font-size:7.5px;font-weight:600;letter-spacing:1px;padding:2px 5px;border-radius:3px;margin-top:5px;display:inline-block}
#tip .g{color:" & _cGood & "}#tip .a{color:" & _cWarn & "}#tip .n{color:" & _cBad & "}
.empty{padding:24px;font-size:12px;color:" & _cMuted & "}
</style></head><body>
<div class='tc'>
 <div class='hdr'>
  <div>
   <div class='badge'><svg width='10' height='10' viewBox='0 0 24 24' fill='none' stroke='" & _cNavy & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 20 C9 20 9 4 21 4'/></svg><span>" & _Badge & "</span></div>
   <div class='ttl'>" & _Title & "</div>
   <div class='sub'>" & _Subtitle & "</div>
   <div class='kpi'>
    <div class='pill' id='hPill'><svg id='hArr' width='10' height='10' viewBox='0 0 24 24' fill='none' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='18 15 12 9 6 15'/></svg><span id='hVar'>—</span></div>
    <span class='k-l'>Actual</span><span class='k-v' id='hA'>—</span>
    <span class='k-l'>vs Plan</span><span class='k-v' id='hP'>—</span>
    <span class='k-r' id='hRange'></span>
   </div>
  </div>
  <div class='rgt'>
   <div class='dd' id='hDD'>Cut-off —</div>
   <div class='chip' id='hChip'><b id='hSpi'>SPI —</b><i id='hSt'></i></div>
   <div class='mth' id='hMth'></div>
   <div class='lg'>
    <span><em style='width:14px;height:2.5px;border-radius:2px;background:" & _cActLine & "'></em>Actual cum.</span>
    <span><em style='width:14px;height:0;border-top:2px dashed " & _cPlanLine & "'></em>Plan cum.</span>
    <span><em style='width:5px;height:8px;border-radius:1px;background:" & _cActBar & "'></em>Actual period</span>
    <span><em style='width:5px;height:8px;border-radius:1px;background:" & _cPlanBar & "'></em>Plan period</span>
   </div>
  </div>
 </div>
 <div class='chart' id='chart'><div id='tip'></div></div>
</div>
<script>
(function(){
var rd=[" & _D & "],rpp=[" & _PP & "],rap=[" & _AP & "],op=[" & _O & "],wt=" & _Wt & ",co=" & _CO & ",vw=" & _VW & "/100;
var C={ink:'" & _cInk & "',sub:'" & _cText & "',mut:'" & _cMuted & "',act:'" & _cActLine & "',plan:'" & _cPlanLine & "',abar:'" & _cActBar & "',pbar:'" & _cPlanBar & "',sep:'" & _cSep & "',good:'" & _cGood & "',warn:'" & _cWarn & "',bad:'" & _cBad & "'};
var MN=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
var el=document.getElementById('chart'),tip=document.getElementById('tip'),n=rd.length,i;
if(n<2){el.innerHTML='<div class=empty>Not enough S-Curve data for the selected scope.</div>';return}
function toT(c){return Date.UTC(Math.floor(c/10000),Math.floor(c/100)%100-1,c%100)}
function D(ms){return new Date(ms)}
function mon(ms){return MN[D(ms).getUTCMonth()]}
function yr(ms){return D(ms).getUTCFullYear()}
function yy(ms){return String.fromCharCode(39)+String(yr(ms)).slice(2)}
function dLbl(ms){return D(ms).getUTCDate()+' '+mon(ms)+' '+yr(ms)}
function sLbl(ms){return D(ms).getUTCDate()+' '+mon(ms)+' '+yy(ms)}
function mLbl(ms){return mon(ms)+' '+yr(ms)}
function pct(v){return v===null||v===undefined||isNaN(v)?'—':v.toFixed(1)+'%'}
function pts(v){return (v>=0?'+':'')+v.toFixed(1)+' pts'}
function rgba(h,o){var r=parseInt(h.substr(1,2),16),g=parseInt(h.substr(3,2),16),b=parseInt(h.substr(5,2),16);return 'rgba('+r+','+g+','+b+','+o+')'}
function nz(v){return v===null?0:v}

/* ---------- PERIODS + CUMULATIVE = OPENING + RUNNING SUM OF PERIODIC ---------- */
var t=[],pp=[],ap=[],pc=[],ac=[],dd=-1;
for(i=0;i<n;i++){t.push(toT(rd[i]));pp.push(rpp[i]/10000);ap.push(rap[i]/10000)}
co=toT(co);for(i=0;i<n;i++){if(t[i]<=co)dd=i}
var P0=op[0]/10000,A0=op[1]/10000,cP=P0,cA=A0;
for(i=0;i<n;i++){cP+=pp[i];pc.push(cP);if(i<=dd){cA+=ap[i];ac.push(cA)}else{ap[i]=null;ac.push(null)}}
var gs=[];for(i=1;i<n;i++)gs.push(t[i]-t[i-1]);gs.sort(function(a,b){return a-b});
var gap=gs[Math.floor(gs.length/2)]||2629800000,t0=Math.min(t[0]-gap,co),tEnd=Math.max(t[n-1],co)+gap*0.5;
/* plan curve interpolated at any date (PV @ status date) */
function planAtT(ms){if(ms<=t0)return P0;if(ms>=t[n-1])return pc[n-1];var pt=t0,pv=P0;for(var j=0;j<n;j++){if(ms<=t[j])return pv+(pc[j]-pv)*(ms-pt)/(t[j]-pt);pt=t[j];pv=pc[j]}return pc[n-1]}

/* ---------- KPI @ CUT-OFF ---------- */
var A=dd>=0?ac[dd]:null,P=planAtT(co);
var V=A!==null?A-P:null,SPI=(A!==null&&P>0)?A/P:null;
var st=V===null?'n':V>=0?'g':V>=vw?'a':'n';
var SC=V===null?C.mut:st==='g'?C.good:st==='a'?C.warn:C.bad;
var ST=V===null?'NO ACTUAL':st==='g'?'ON PLAN':st==='a'?'MONITOR':'AT RISK';
var up=V!==null&&V>=0;
document.getElementById('hPill').style.background=rgba(SC,0.1);
var arr=document.getElementById('hArr');arr.setAttribute('stroke',SC);arr.innerHTML='<polyline points='+(up?'18,15,12,9,6,15':'6,9,12,15,18,9')+' />';
var hv=document.getElementById('hVar');hv.textContent=V===null?'—':pts(V);hv.style.color=SC;
document.getElementById('hA').textContent=pct(A);
document.getElementById('hP').textContent=pct(P);
document.getElementById('hRange').textContent='('+mLbl(t[0])+' — '+mLbl(t[n-1])+')'+(wt<995?' · scope '+(wt/10).toFixed(1)+'% of project':'');
document.getElementById('hDD').textContent='Cut-off · '+dLbl(co)+(dd>=0&&t[dd]<co?' · measured '+sLbl(t[dd]):'');
var chip=document.getElementById('hChip');chip.style.background=rgba(SC,0.1);
var hs=document.getElementById('hSpi');hs.textContent='SPI '+(SPI===null?'—':SPI.toFixed(2));hs.style.color=SC;
var ht=document.getElementById('hSt');ht.textContent=ST;ht.style.color=SC;
if(dd>=0){document.getElementById('hMth').innerHTML='Last period <b>'+pct(ap[dd])+'</b> vs plan <b>'+pct(pp[dd])+'</b>'}

/* ---------- PEAK PERIOD / MAX SLIP (actual periods only) ---------- */
var pkI=-1,slI=-1,pkV=-1e9,slV=1e9;
for(i=0;i<=dd;i++){if(ap[i]>pkV){pkV=ap[i];pkI=i}var sv=ap[i]-pp[i];if(sv<slV){slV=sv;slI=i}}
if(slV>=0)slI=-1;if(slI===pkI)slI=-1;

/* ---------- MONOTONE CUBIC PATH (no overshoot, S-curve safe) ---------- */
function mono(p){var k=p.length;if(k<2)return'';var f=function(v){return v.toFixed(1)};if(k===2)return 'M'+f(p[0].x)+','+f(p[0].y)+'L'+f(p[1].x)+','+f(p[1].y);
var dx=[],m=[],tg=[],j;for(j=0;j<k-1;j++){dx[j]=p[j+1].x-p[j].x;m[j]=(p[j+1].y-p[j].y)/dx[j]}
tg[0]=m[0];tg[k-1]=m[k-2];for(j=1;j<k-1;j++){if(m[j-1]*m[j]<=0){tg[j]=0}else{var w1=2*dx[j]+dx[j-1],w2=dx[j]+2*dx[j-1];tg[j]=(w1+w2)/(w1/m[j-1]+w2/m[j])}}
var d='M'+f(p[0].x)+','+f(p[0].y);for(j=0;j<k-1;j++){var h=dx[j]/3;d+='C'+f(p[j].x+h)+','+f(p[j].y+tg[j]*h)+' '+f(p[j+1].x-h)+','+f(p[j+1].y-tg[j+1]*h)+' '+f(p[j+1].x)+','+f(p[j+1].y)}return d}

var ns='http://www.w3.org/2000/svg',first=true;
function E(tag,at,par){var e=document.createElementNS(ns,tag);for(var a in at)e.setAttribute(a,at[a]);if(par)par.appendChild(e);return e}
function T(txt,at,par){var e=E('text',at,par);e.textContent=txt;return e}

function draw(){
 var old=el.querySelector('svg');if(old)el.removeChild(old);tip.style.opacity='0';
 var W=el.clientWidth||600,H=el.clientHeight||260;
 var pad={l:42,r:46,t:44,b:50},cw=W-pad.l-pad.r,ch=H-pad.t-pad.b;if(cw<50||ch<40)return;
 var base=pad.t+ch,span=tEnd-t0;
 function X(ms){return pad.l+(ms-t0)/span*cw}
 var xs=t.map(X),x0=X(t0);
 var cMax=100;for(i=0;i<n;i++){cMax=Math.max(cMax,pc[i],nz(ac[i]))}
 var bMax=0;for(i=0;i<n;i++){bMax=Math.max(bMax,pp[i],nz(ap[i]))}
 bMax=bMax*1.15;bMax=bMax>=2?Math.ceil(bMax):(Math.ceil(bMax*10)/10||1);
 var bH=ch*0.40;
 function yC(v){return base-(v/cMax)*ch}
 function yB(v){return base-(Math.max(0,v)/bMax)*bH}
 var svg=E('svg',{viewBox:'0 0 '+W+' '+H,preserveAspectRatio:'none'});
 var defs=E('defs',{},svg);
 var gr=E('linearGradient',{id:'ag',x1:0,y1:0,x2:0,y2:1},defs);E('stop',{offset:'0%','stop-color':C.act,'stop-opacity':0.14},gr);E('stop',{offset:'100%','stop-color':C.act,'stop-opacity':0.01},gr);
 var cp=E('clipPath',{id:'cp'},defs);var cr=E('rect',{x:0,y:0,width:first?0:W,height:H},cp);
 if(first){E('animate',{attributeName:'width',from:0,to:W,dur:'1.1s',fill:'freeze',calcMode:'spline',keySplines:'0.4 0 0.2 1',keyTimes:'0;1'},cr)}

 /* grid + axes */
 for(var g=0;g<=4;g++){var v=cMax*g/4,gy=yC(v);E('line',{x1:pad.l,x2:W-pad.r,y1:gy,y2:gy,'class':'grid'},svg);T(Math.round(v)+'%',{x:pad.l-8,y:gy+3,'text-anchor':'end','class':'ax'},svg)}
 [0,bMax/2,bMax].forEach(function(v){T((v%1?v.toFixed(1):v)+'%',{x:W-pad.r+8,y:yB(v)+3,'text-anchor':'start','class':'ax'},svg)});
 T('CUM %',{x:6,y:pad.t-12,'text-anchor':'start','class':'ax','letter-spacing':1,'font-size':'7px'},svg);
 T('PERIODIC %',{x:W-6,y:yB(bMax)-12,'text-anchor':'end','class':'ax','letter-spacing':1,'font-size':'7px'},svg);

 /* cut-off line + forecast zone */
 var xco=X(co);
 if(xco>pad.l&&xco<W-pad.r){E('rect',{x:xco,y:pad.t,width:W-pad.r-xco,height:ch,fill:C.ink,'fill-opacity':0.025},svg);
  E('line',{x1:xco,x2:xco,y1:pad.t,y2:base+4,stroke:C.ink,'stroke-width':0.9,'stroke-dasharray':'3,3','stroke-opacity':0.5},svg);
  if(W-pad.r-xco>80)T('FORECAST',{'class':'halo',x:(xco+W-pad.r)/2,y:pad.t+ch*0.38,'text-anchor':'middle','font-size':'7px','font-weight':500,'letter-spacing':2,fill:C.mut,'fill-opacity':0.6},svg)}

 /* x-axis : period labels (thinned by space) + year bands */
 var lx=-1e9,lm=-1;
 for(i=0;i<n;i++){var mk=yr(t[i])*12+D(t[i]).getUTCMonth();if(xs[i]-lx>=28&&mk!==lm&&Math.abs(xs[i]-xco)>44){T(mon(t[i]).toUpperCase(),{x:xs[i],y:base+15,'class':'yr'},svg);lx=xs[i];lm=mk}}
 for(var y=yr(t0)+1;y<=yr(tEnd);y++){var xj=X(Date.UTC(y,0,1));if(xj>pad.l&&xj<W-pad.r)E('line',{x1:xj,x2:xj,y1:pad.t,y2:base+36,stroke:C.sep,'stroke-width':0.7},svg)}
 var ys=0,lyx=-1e9;for(i=1;i<=n;i++){if(i===n||yr(t[i])!==yr(t[ys])){var xm=(xs[ys]+xs[i-1])/2;if(xm-lyx>=26){T(yy(t[ys]),{x:xm,y:base+34,'class':'yy'},svg);lyx=xm}ys=i}}

 /* cut-off tag on the axis (never collides with bars) */
 if(xco>pad.l&&xco<W-pad.r){var ctx=Math.max(pad.l+39,Math.min(W-pad.r-39,xco)),cg0=E('g',{},svg);
  E('rect',{x:ctx-39,y:base+5,width:78,height:14,rx:7,fill:C.ink},cg0);
  T('CUT-OFF '+D(co).getUTCDate()+' '+mon(co).toUpperCase(),{x:ctx,y:base+15,'text-anchor':'middle','font-size':'6.5px','font-weight':700,'letter-spacing':0.6,fill:'#FFFFFF'},cg0)}

 /* periodic bars : width follows the period spacing */
 var gp=[];for(i=0;i<n;i++){var gL=xs[i]-(i?xs[i-1]:x0),gR=i<n-1?xs[i+1]-xs[i]:gL;gp.push(Math.min(gL,gR))}
 var sg=gp.slice().sort(function(a,b){return a-b}),mg=sg[Math.floor(n/2)];
 var bg=E('g',{'clip-path':'url(#cp)'},svg);
 for(i=0;i<n;i++){var gw=Math.max(4,Math.min(40,Math.min(gp[i],mg*1.2)*0.62)),bw=gw/2-0.5,rx=Math.min(2,bw/3);
  if(pp[i]>0){var yp=yB(pp[i]);E('rect',{x:xs[i]-bw-0.5,y:yp,width:bw,height:base-yp,rx:rx,fill:C.pbar,'fill-opacity':0.85},bg)}
  if(ap[i]!==null&&ap[i]>0){var ya=yB(ap[i]);E('rect',{x:xs[i]+0.5,y:ya,width:bw,height:base-ya,rx:rx,fill:C.abar,'fill-opacity':0.9},bg)}}

 /* peak period / max slip markers (reference style) */
 function mark(idx,col,txt){var mx=xs[idx];E('line',{x1:mx,x2:mx,y1:base,y2:yC(nz(ac[idx]))+10,stroke:col,'stroke-width':1,'stroke-opacity':0.3,'stroke-dasharray':'3,2'},svg);
  T(txt,{x:mx,y:base+46,'text-anchor':'middle','font-size':'7px','font-weight':600,fill:col,'fill-opacity':0.85},svg)}
 if(pkI>=0&&pkI!==dd)mark(pkI,C.good,'PEAK '+pkV.toFixed(1)+'%');
 if(slI>=0&&slI!==dd)mark(slI,C.bad,'SLIP '+slV.toFixed(1));

 /* cumulative curves (start from opening balance at period zero) */
 var pP=[{x:x0,y:yC(P0)}],aP=[{x:x0,y:yC(A0)}];
 for(i=0;i<n;i++){pP.push({x:xs[i],y:yC(pc[i])})}for(i=0;i<=dd;i++){aP.push({x:xs[i],y:yC(ac[i])})}
 var lg=E('g',{'clip-path':'url(#cp)'},svg);
 if(aP.length>1){var ad=mono(aP);E('path',{d:ad+'L'+aP[aP.length-1].x+','+base+'L'+aP[0].x+','+base+'Z',fill:'url(#ag)'},lg)}
 E('path',{d:mono(pP),fill:'none',stroke:C.plan,'stroke-width':1.8,'stroke-dasharray':'5,4','stroke-linecap':'round'},lg);
 if(aP.length>1)E('path',{d:mono(aP),fill:'none',stroke:C.act,'stroke-width':2.4,'stroke-linecap':'round','stroke-linejoin':'round'},lg);
 if(dd>=0&&xco>xs[dd]+2)E('line',{x1:xs[dd],x2:xco,y1:yC(A),y2:yC(A),stroke:C.act,'stroke-width':1.6,'stroke-dasharray':'2,3','stroke-opacity':0.8},lg);

 /* plan finish label */
 var lp=n-1;
 if(lp!==dd){var fg=E('g',{'class':'fade'},svg);E('circle',{cx:xs[lp],cy:yC(pc[lp]),r:3,fill:'#FFF',stroke:C.plan,'stroke-width':1.3},fg);
  if(dd<0||xs[lp]-xco>120){T('PLAN FINISH',{'class':'halo',x:xs[lp],y:yC(pc[lp])-20,'text-anchor':'end','font-size':'7px','font-weight':500,'letter-spacing':1.2,fill:C.plan,'fill-opacity':0.7},fg);
  T(pct(pc[lp])+' · '+mon(t[lp])+' '+yy(t[lp]),{'class':'halo',x:xs[lp],y:yC(pc[lp])-9,'text-anchor':'end','font-size':'9px','font-weight':600,fill:C.plan},fg)}}

 /* data-date callout : actual pill + plan point + variance bracket */
 if(dd>=0){var cg=E('g',{'class':'fade'},svg),px=xco,ay=yC(A),py=yC(P),behind=A<P;
  E('line',{x1:px,x2:px,y1:ay,y2:py,stroke:SC,'stroke-width':1.6,'stroke-opacity':0.55},cg);
  E('circle',{cx:px,cy:py,r:3,fill:'#FFF',stroke:C.plan,'stroke-width':1.3},cg);
  var right=px+70<W-pad.r,vx=right?px+9:px-9,va=right?'start':'end';
  if(Math.abs(ay-py)>12)T(pts(V),{'class':'halo',x:vx,y:(ay+py)/2+3,'text-anchor':va,'font-size':'8.5px','font-weight':600,fill:SC},cg);
  T('PLAN '+pct(P),{'class':'halo',x:px,y:behind?py-9:py+15,'text-anchor':'middle','font-size':'7.5px','font-weight':500,fill:C.plan,'fill-opacity':0.85},cg);
  var pw=58,phh=20,pyy=(behind||ay-36<pad.t+6)?ay+14:ay-36;pyy=Math.max(pad.t-4,Math.min(base-phh-2,pyy));var pxx=Math.max(pad.l,Math.min(W-pad.r-pw,px-pw/2));
  T('ACTUAL',{x:pxx+pw/2,y:pyy>ay?pyy+phh+9:pyy-4,'text-anchor':'middle','font-size':'7px','font-weight':500,'letter-spacing':1.5,fill:SC,'fill-opacity':0.7},cg);
  E('rect',{x:pxx,y:pyy,width:pw,height:phh,rx:10,fill:'#FFF'},cg);
  E('rect',{x:pxx,y:pyy,width:pw,height:phh,rx:10,fill:SC,'fill-opacity':0.12,stroke:SC,'stroke-width':0.8,'stroke-opacity':0.3},cg);
  T(pct(A),{x:pxx+pw/2,y:pyy+13.5,'text-anchor':'middle','font-size':'10.5px','font-weight':600,fill:SC},cg);
  E('circle',{cx:px,cy:ay,r:7,fill:'none',stroke:SC,'stroke-width':1.5,'class':'pulse'},cg);
  E('circle',{cx:px,cy:ay,r:3.2,fill:SC},cg);E('circle',{cx:px,cy:ay,r:1.1,fill:'#FFF'},cg)}

 /* hover layer : one zone per reporting date */
 var gl=E('line',{y1:pad.t,y2:base,stroke:C.ink,'stroke-width':0.6,'stroke-opacity':0,'stroke-dasharray':'2,2'},svg);
 var hdA=E('circle',{r:3.5,fill:C.act,opacity:0},svg),hdP=E('circle',{r:3,fill:'#FFF',stroke:C.plan,'stroke-width':1.3,opacity:0},svg);
 for(i=0;i<n;i++){(function(k){var zl=k?(xs[k-1]+xs[k])/2:pad.l,zr=k<n-1?(xs[k]+xs[k+1])/2:W-pad.r;
  var hz=E('rect',{x:zl,y:pad.t,width:Math.max(1,zr-zl),height:ch,fill:'transparent',cursor:'pointer'},svg);
  hz.addEventListener('mouseenter',function(){var hx=xs[k];gl.setAttribute('x1',hx);gl.setAttribute('x2',hx);gl.setAttribute('stroke-opacity',0.35);
   if(ac[k]!==null){hdA.setAttribute('cx',hx);hdA.setAttribute('cy',yC(ac[k]));hdA.setAttribute('opacity',1)}else{hdA.setAttribute('opacity',0)}
   hdP.setAttribute('cx',hx);hdP.setAttribute('cy',yC(pc[k]));hdP.setAttribute('opacity',1);
   var h='<div class=h>'+dLbl(t[k])+'</div><div class=pd>'+(k?'Period '+sLbl(t[k-1])+' → '+sLbl(t[k]):'First reporting period')+'</div>';
   h+='<div class=r><span class=\'sw sa\'></span>Actual cum.<b>'+pct(ac[k])+'</b></div>';
   h+='<div class=r><span class=\'sw sp\'></span>Plan cum.<b>'+pct(pc[k])+'</b></div>';
   if(ac[k]!==null){var dv=ac[k]-pc[k],sp=pc[k]>0?ac[k]/pc[k]:null,cl=sp===null?'':sp>=1?'g':sp>=0.95?'a':'n';
    h+='<div class=r>Variance<b class='+cl+'>'+pts(dv)+(sp!==null?' · SPI '+sp.toFixed(2):'')+'</b></div>'}
   h+='<div class=hr></div>';
   h+='<div class=r><span class=\'sw ba\'></span>Actual period<b>'+pct(ap[k])+'</b></div>';
   h+='<div class=r><span class=\'sw bp\'></span>Plan period<b>'+pct(pp[k])+'</b></div>';
   if(k===dd)h+='<div class=\'fc g\' style=background:'+rgba(SC,0.12)+';color:'+SC+'>LAST MEASUREMENT</div>';
   else if(k>dd)h+='<div class=fc style=background:'+rgba(C.mut,0.12)+';color:'+C.mut+'>FORECAST · PLAN ONLY</div>';
   else if(k===pkI)h+='<div class=fc style=background:'+rgba(C.good,0.12)+';color:'+C.good+'>PEAK PERIOD PROGRESS</div>';
   else if(k===slI)h+='<div class=fc style=background:'+rgba(C.bad,0.12)+';color:'+C.bad+'>LARGEST PERIOD SLIP</div>';
   tip.innerHTML=h;tip.style.opacity='1';
   var tw=tip.offsetWidth,th=tip.offsetHeight,ty=Math.min(ac[k]!==null?yC(ac[k]):base,yC(pc[k]));
   var tx=hx+14;if(tx+tw>W-4)tx=hx-tw-14;if(tx<4)tx=4;
   ty=ty-th/2;if(ty<4)ty=4;if(ty+th>H-4)ty=H-th-4;
   tip.style.left=tx+'px';tip.style.top=ty+'px'});
  hz.addEventListener('mouseleave',function(){gl.setAttribute('stroke-opacity',0);hdA.setAttribute('opacity',0);hdP.setAttribute('opacity',0);tip.style.opacity='0'})})(i)}
 el.insertBefore(svg,tip);first=false;
}
draw();
var rt;window.addEventListener('resize',function(){clearTimeout(rt);rt=setTimeout(draw,120)});
})();
</script></body></html>"

-- 6. OUTPUT -------------------------------------------------------------
RETURN
    IF (
        _Count < 2 || ( _Normalize && NOT ( _TotPP > 0 ) ),
        "<div style='font-family:Segoe UI,sans-serif;padding:24px;font-size:12px;color:" & _cMuted & "'>Not enough S-Curve data for the selected scope.</div>",
        _Html
    )
