ENG HTML - Discipline Performance =
/* =====================================================================
   DISCIPLINE PERFORMANCE  ⇄  DOCUMENT MATURITY   ·  HTML Content visual
   ---------------------------------------------------------------------
   Frame   : 435 px high (unchanged) · flip via pure CSS (checkbox+label)
   Front   : discipline matrix sorted worst variance first · progress
             bullet (actual fill + plan tick) · diverging variance bar ·
             earned MH share · RAG status · engineering total row
   Back    : document status distribution · stage pipeline IFR→IFA→IFC ·
             weighted maturity (rules of credit) · auto narrative
   Style   : monochrome report · RAG colour only as status accent
   ===================================================================== */

-- 1. CONFIG ---------------------------------------------------------------
VAR _VarWatch = -0.02      -- variance below this = AT RISK (fraction)
VAR _wIFR     = 0.50       -- rules of credit for maturity index
VAR _wIFA     = 0.80
VAR _wIFC     = 1.00

-- 2. PALETTE (matches PMIS dashboard) -------------------------------------
VAR _cInk   = "#1C3A5E"
VAR _cText  = "#6B7785"
VAR _cMuted = "#8A9099"
VAR _cLine  = "#E6EBF1"
VAR _cSoft  = "#F6F8FB"
VAR _cData  = "#56698F"    -- slate (actual / primary series)
VAR _cData2 = "#C9D2DE"    -- light slate (track / secondary)
VAR _cIFR   = "#C9D2DE"
VAR _cIFA   = "#8C9BB5"
VAR _cIFC   = "#243761"
VAR _cGood  = "#0F9B80"
VAR _cWarn  = "#E39016"
VAR _cBad   = "#D65365"

-- 3. DISCIPLINE DATA -----------------------------------------------------
VAR _D =
    ADDCOLUMNS (
        FILTER ( VALUES ( 'Dim_Discipline'[Discipline_Name] ), NOT ISBLANK ( 'Dim_Discipline'[Discipline_Name] ) ),
        "@P",  [ENG Planned Progress %],
        "@A",  [ENG Actual Progress %],
        "@V",  [ENG Progress Variance %],
        "@MH", [ENG Earned MH]
    )
VAR _N      = COUNTROWS ( _D )
VAR _TotMH  = SUMX ( _D, [@MH] )
VAR _MaxAbs = MAX ( 0.005, MAXX ( _D, ABS ( [@V] ) ) )
VAR _nOn    = COUNTROWS ( FILTER ( _D, NOT ISBLANK ( [@V] ) && [@V] >= 0 ) ) + 0
VAR _nMon   = COUNTROWS ( FILTER ( _D, NOT ISBLANK ( [@V] ) && [@V] < 0 && [@V] >= _VarWatch ) ) + 0
VAR _nRisk  = COUNTROWS ( FILTER ( _D, NOT ISBLANK ( [@V] ) && [@V] < _VarWatch ) ) + 0

-- Engineering total (current filter context, all disciplines)
VAR _TP = [ENG Planned Progress %]
VAR _TA = [ENG Actual Progress %]
VAR _TV = [ENG Progress Variance %]

VAR _Rows =
    CONCATENATEX (
        _D,
        VAR _v    = [@V]
        VAR _st   = SWITCH ( TRUE (), ISBLANK ( _v ), "NO DATA", _v >= 0, "ON PLAN", _v >= _VarWatch, "MONITOR", "AT RISK" )
        VAR _sc   = SWITCH ( _st, "ON PLAN", _cGood, "MONITOR", _cWarn, "AT RISK", _cBad, _cMuted )
        VAR _vc   = SWITCH ( TRUE (), ISBLANK ( _v ), _cMuted, _v >= 0, _cGood, _v < _VarWatch, _cBad, _cInk )
        VAR _vt   = IF ( ISBLANK ( _v ), "—", IF ( _v > 0, "+", "" ) & FORMAT ( _v * 100, "0.00" ) & " pts" )
        VAR _pA   = FORMAT ( ROUND ( MIN ( 1, MAX ( 0, [@A] ) ) * 100, 0 ), "0" )
        VAR _pP   = FORMAT ( ROUND ( MIN ( 1, MAX ( 0, [@P] ) ) * 100, 0 ), "0" )
        VAR _w    = ROUND ( ABS ( _v ) / _MaxAbs * 48, 0 )
        VAR _bar  =
            IF ( ISBLANK ( _v ), "",
                "<b style='left:" & FORMAT ( IF ( _v < 0, 50 - _w, 50 ), "0" ) & "%;width:" & FORMAT ( _w, "0" )
                    & "%;background:" & IF ( _v >= 0, _cGood, _cData ) & "'></b>" )
        VAR _mhs  = FORMAT ( DIVIDE ( [@MH], _TotMH, 0 ), "0%" )
        RETURN
            "<div class='row'>"
                & "<div class='c-name'><span class='nm'>" & 'Dim_Discipline'[Discipline_Name] & "</span></div>"
                & "<div class='c-prog'><div class='pb'><div class='pf' style='width:" & _pA & "%'></div><div class='pt' style='left:" & _pP & "%'></div></div></div>"
                & "<div class='c-num'>" & IF ( ISBLANK ( [@P] ), "—", FORMAT ( [@P], "0.0%" ) ) & "</div>"
                & "<div class='c-num strong'>" & IF ( ISBLANK ( [@A] ), "—", FORMAT ( [@A], "0.0%" ) ) & "</div>"
                & "<div class='c-var'><span style='color:" & _vc & "'>" & _vt & "</span><div class='vb'><i></i>" & _bar & "</div></div>"
                & "<div class='c-num'>" & IF ( ISBLANK ( [@MH] ), "—", FORMAT ( [@MH], "#,##0" ) ) & "<small>" & _mhs & "</small></div>"
                & "<div class='c-st'><span class='st'><i style='background:" & _sc & "'></i>" & _st & "</span></div>"
                & "</div>",
        "",
        [@V], ASC,
        'Dim_Discipline'[Discipline_Name], ASC
    )

VAR _TStat = SWITCH ( TRUE (), ISBLANK ( _TV ), "NO DATA", _TV >= 0, "ON PLAN", _TV >= _VarWatch, "MONITOR", "AT RISK" )
VAR _TCol  = SWITCH ( _TStat, "ON PLAN", _cGood, "MONITOR", _cWarn, "AT RISK", _cBad, _cMuted )
VAR _TVt   = IF ( ISBLANK ( _TV ), "—", IF ( _TV > 0, "+", "" ) & FORMAT ( _TV * 100, "0.00" ) & " pts" )
VAR _TpA   = FORMAT ( ROUND ( MIN ( 1, MAX ( 0, _TA ) ) * 100, 0 ), "0" )
VAR _TpP   = FORMAT ( ROUND ( MIN ( 1, MAX ( 0, _TP ) ) * 100, 0 ), "0" )

-- 4. DOCUMENT MATURITY ----------------------------------------------------
VAR _IFR    = COALESCE ( [ENG IFR Issued], 0 )
VAR _IFA    = COALESCE ( [ENG IFA Issued], 0 )
VAR _IFC    = COALESCE ( [ENG IFC Issued], 0 )
VAR _OnHold = COALESCE ( [ENG On Hold], 0 )
VAR _Tot    = _IFR + _IFA + _IFC + _OnHold

VAR _sIFR  = FORMAT ( DIVIDE ( _IFR, _Tot, 0 ), "0%" )
VAR _sIFA  = FORMAT ( DIVIDE ( _IFA, _Tot, 0 ), "0%" )
VAR _sIFC  = FORMAT ( DIVIDE ( _IFC, _Tot, 0 ), "0%" )
VAR _sHold = FORMAT ( DIVIDE ( _OnHold, _Tot, 0 ), "0.0%" )
VAR _gIFR  = FORMAT ( DIVIDE ( _IFR + _IFA + _IFC, _Tot, 0 ), "0%" )   -- reached ≥ IFR
VAR _gIFA  = FORMAT ( DIVIDE ( _IFA + _IFC, _Tot, 0 ), "0%" )          -- reached ≥ IFA
VAR _wR    = ROUND ( DIVIDE ( _IFR, _Tot, 0 ) * 100, 1 )
VAR _wA    = ROUND ( DIVIDE ( _IFA, _Tot, 0 ) * 100, 1 )
VAR _wC    = ROUND ( DIVIDE ( _IFC, _Tot, 0 ) * 100, 1 )
-- integer widths for CSS (locale-safe); on-hold takes the remainder
VAR _pR    = FORMAT ( ROUND ( _wR, 0 ), "0" )
VAR _pA2   = FORMAT ( ROUND ( _wA, 0 ), "0" )
VAR _pC    = FORMAT ( ROUND ( _wC, 0 ), "0" )
VAR _pH    = FORMAT ( MAX ( 0, 100 - ROUND ( _wR, 0 ) - ROUND ( _wA, 0 ) - ROUND ( _wC, 0 ) ), "0" )
VAR _Mat   = DIVIDE ( _IFR * _wIFR + _IFA * _wIFA + _IFC * _wIFC, _Tot, 0 )
VAR _sMat  = FORMAT ( _Mat, "0.0%" )
VAR _pMat  = FORMAT ( ROUND ( _Mat * 100, 0 ), "0" )
VAR _DocNarr =
    IF ( _Tot = 0, "No document status recorded for the selected scope.",
        _sIFC & " of documents have reached IFC and " & _gIFA & " are at IFA or beyond; "
            & _sIFR & " remain at IFR. " & FORMAT ( _OnHold, "#,##0" ) & " documents (" & _sHold & ") are on hold." )

-- 5. ICONS ----------------------------------------------------------------
VAR _IcoDoc  = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z'/><path d='M14 3v5h5'/><path d='M9 13h6M9 17h4'/></svg>"
VAR _IcoGrid = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M4 6h16M4 12h16M4 18h16'/><path d='M9 4v16'/></svg>"
VAR _IcoArr  = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M9 6l6 6-6 6'/></svg>"

-- 6. HTML -----------------------------------------------------------------
RETURN
"<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;height:100%;overflow:hidden;background:transparent!important;font-family:'Segoe UI',Arial,sans-serif;font-variant-numeric:tabular-nums;color:" & _cInk & "}
.wrap{width:100%;height:435px;position:relative;perspective:1600px}
.tg{position:absolute;opacity:0;width:1px;height:1px;pointer-events:none}
.card3d{width:100%;height:435px;position:relative;transform-style:preserve-3d;transition:transform .65s cubic-bezier(.22,.61,.36,1)}
.tg:checked~.card3d{transform:rotateY(180deg)}
.face{position:absolute;inset:0;display:flex;flex-direction:column;padding:16px 20px 14px;background:#FFFFFF;border:1px solid " & _cLine & ";border-radius:14px;box-shadow:0 4px 14px rgba(28,58,94,.045);overflow:hidden;backface-visibility:hidden;-webkit-backface-visibility:hidden}
.back{transform:rotateY(180deg)}

/* header */
.hd{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:0 2px 12px;border-bottom:1px solid " & _cLine & ";flex-shrink:0}
.kk{font-size:8px;font-weight:700;letter-spacing:.16em;color:" & _cMuted & ";text-transform:uppercase}
.tt{margin-top:4px;font-size:17px;line-height:1.15;font-weight:700;letter-spacing:-.02em;color:" & _cInk & ";white-space:nowrap}
.sb{margin-top:3px;font-size:9.5px;font-weight:400;color:" & _cText & ";white-space:nowrap}
.hr{display:flex;flex-direction:column;align-items:flex-end;gap:8px}
.btn{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border:1px solid " & _cLine & ";border-radius:7px;background:#FFFFFF;color:" & _cInk & ";font-size:7.5px;font-weight:700;letter-spacing:.08em;cursor:pointer;white-space:nowrap;transition:all .18s ease}
.btn svg{width:12px;height:12px;color:" & _cData & "}
.btn:hover{background:" & _cInk & ";border-color:" & _cInk & ";color:#FFFFFF}.btn:hover svg{color:#FFFFFF}
.chips{display:flex;gap:10px;font-size:8px;font-weight:600;color:" & _cText & ";white-space:nowrap}
.chips span{display:inline-flex;align-items:center;gap:4px}.chips b{color:" & _cInk & "}
.chips i,.st i,.lg i{width:6px;height:6px;border-radius:50%;display:inline-block;flex-shrink:0}

/* matrix */
.grid{display:grid;grid-template-columns:minmax(0,24%) 19% 8% 8% 17% 12% 12%;align-items:center;padding:0 6px}
.th{height:30px;flex-shrink:0;font-size:7px;font-weight:700;letter-spacing:.11em;color:" & _cMuted & ";text-transform:uppercase;border-bottom:1px solid " & _cLine & "}
.th div{white-space:nowrap}
.r{text-align:right;padding-right:10px}.ctr{text-align:center}
.body{flex:1;min-height:0;display:flex;flex-direction:column;overflow-y:auto}
.body::-webkit-scrollbar{width:4px}.body::-webkit-scrollbar-thumb{background:" & _cLine & ";border-radius:2px}
.row{display:grid;grid-template-columns:minmax(0,24%) 19% 8% 8% 17% 12% 12%;align-items:center;padding:0 6px;flex:1 1 0;min-height:25px;max-height:36px;border-bottom:1px solid #F1F4F7;transition:background .15s ease}
.row:hover{background:" & _cSoft & "}
.c-name{min-width:0;padding-right:8px}
.nm{display:block;font-size:10px;font-weight:600;color:" & _cInk & ";white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.c-prog{padding-right:14px}
.pb{position:relative;height:6px;border-radius:3px;background:#EDF1F5}
.pf{height:100%;border-radius:3px;background:" & _cData & "}
.pt{position:absolute;top:-3px;bottom:-3px;width:2px;margin-left:-1px;border-radius:1px;background:" & _cInk & "}
.c-num{text-align:right;padding-right:10px;font-size:10px;font-weight:600;color:" & _cText & ";white-space:nowrap}
.c-num.strong{color:" & _cInk & ";font-weight:700}
.c-num small{display:block;margin-top:1px;font-size:7px;font-weight:600;color:" & _cMuted & "}
.c-var{display:flex;align-items:center;gap:8px;padding-left:6px}
.c-var span{width:58px;flex-shrink:0;text-align:right;font-size:10px;font-weight:700;white-space:nowrap}
.vb{position:relative;flex:1;height:8px}
.vb i{position:absolute;left:50%;top:-3px;bottom:-3px;width:1px;background:#C3CCD8}
.vb b{position:absolute;top:1px;bottom:1px;border-radius:2px;min-width:2px}
.c-st{display:flex;justify-content:center}
.st{display:inline-flex;align-items:center;gap:5px;min-width:76px;justify-content:center;height:20px;padding:0 8px;border-radius:999px;background:#F4F6F9;border:1px solid " & _cLine & ";font-size:7px;font-weight:700;letter-spacing:.07em;color:" & _cInk & ";white-space:nowrap}
.tot{flex-shrink:0;height:34px;border-top:1.5px solid " & _cInk & ";background:" & _cSoft & ";border-radius:0 0 6px 6px}
.tot .nm{font-weight:700;letter-spacing:.06em;font-size:8.5px;text-transform:uppercase}
.tot .c-num{color:" & _cInk & ";font-weight:700}
.foot{flex-shrink:0;margin-top:7px;display:flex;justify-content:space-between;font-size:7.5px;color:" & _cMuted & "}
.foot span{display:inline-flex;align-items:center;gap:5px}
.lgp{display:inline-block;width:14px;height:5px;border-radius:2px;background:" & _cData & ";position:relative}
.lgp:after{content:'';position:absolute;right:3px;top:-2px;bottom:-2px;width:2px;background:" & _cInk & "}

/* document maturity */
.hero{flex-shrink:0;display:grid;grid-template-columns:auto 1fr auto;gap:22px;align-items:center;padding:14px 4px 12px;border-bottom:1px solid " & _cLine & "}
.hv{font-size:30px;line-height:1;font-weight:700;letter-spacing:-.03em}
.hl{margin-top:4px;font-size:7px;font-weight:700;letter-spacing:.11em;color:" & _cMuted & ";text-transform:uppercase}
.stack{display:flex;height:12px;border-radius:4px;overflow:hidden;background:#EDF1F5}
.stack b{height:100%;display:block}
.stack b+b{border-left:2px solid #FFFFFF}
.lg{display:flex;gap:12px;margin-top:7px;font-size:7.5px;font-weight:600;color:" & _cText & "}
.lg span{display:inline-flex;align-items:center;gap:4px}
.mat{text-align:right}
.mat .hv{font-size:22px}
.mbar{width:110px;height:5px;margin:6px 0 0 auto;border-radius:3px;background:#EDF1F5;overflow:hidden}
.mbar div{height:100%;background:" & _cInk & "}
.pipe{flex:1;min-height:0;display:grid;grid-template-columns:1fr 16px 1fr 16px 1fr 22px 1fr;align-items:stretch;padding:14px 0 12px}
.arw{display:flex;align-items:center;justify-content:center;color:#B4BFCC}.arw svg{width:13px;height:13px}
.sep{display:flex;align-items:center;justify-content:center}.sep:before{content:'';width:1px;height:70%;background:" & _cLine & "}
.stg{justify-content:space-between;padding:12px 13px 11px;background:" & _cSoft & ";border:1px solid " & _cLine & ";border-radius:10px;display:flex;flex-direction:column;transition:transform .16s ease,box-shadow .16s ease}
.stg:hover{transform:translateY(-2px);box-shadow:0 6px 16px rgba(28,58,94,.07)}
.sh{display:flex;justify-content:space-between;align-items:center}
.code{display:inline-flex;align-items:center;gap:6px;font-size:9px;font-weight:700;letter-spacing:.08em;color:" & _cInk & "}
.code i{width:8px;height:8px;border-radius:2px;display:inline-block}
.shr{font-size:7px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:" & _cMuted & "}
.mid{display:flex;align-items:center;justify-content:space-between;gap:8px}
.ring{width:58px;height:58px;flex-shrink:0}
.rt{fill:none;stroke:#E3E9F0;stroke-width:6}
.ring text{font-size:10.5px;font-weight:700;fill:" & _cInk & ";text-anchor:middle}
.num{font-size:26px;line-height:1;font-weight:700;letter-spacing:-.02em;color:" & _cInk & "}
.cap{margin-top:3px;font-size:8px;color:" & _cText & "}
.mini{margin-top:auto;height:5px;border-radius:3px;background:#E3E9F0;overflow:hidden}
.mini div{height:100%;border-radius:3px}
.reach{padding-top:7px;border-top:1px dashed #DCE3EB;display:flex;justify-content:space-between;font-size:7.5px;color:" & _cMuted & "}
.reach b{color:" & _cInk & ";font-size:8.5px}
.nar{flex-shrink:0;position:relative;padding:9px 12px 9px 14px;background:#FFFFFF;border:1px solid " & _cLine & ";border-radius:9px;font-size:8.5px;line-height:1.45;color:" & _cText & "}
.nar:before{content:'';position:absolute;left:0;top:8px;bottom:8px;width:3px;border-radius:2px;background:" & _cInk & "}
.nar b{display:block;font-size:7px;letter-spacing:.12em;color:" & _cMuted & ";margin-bottom:2px}

@media(max-width:760px){
 .ring{width:46px;height:46px}
 .grid,.row{grid-template-columns:minmax(0,30%) 0 10% 10% 22% 14% 14%}.c-prog,.th .pg{visibility:hidden}
 .chips{display:none}.hero{grid-template-columns:auto 1fr}.mat{display:none}.num{font-size:21px}
}
</style>

<div class='wrap'>
<input type='checkbox' id='doc-flip' class='tg'>
<div class='card3d'>

 <!-- ===================== FRONT · DISCIPLINE MATRIX ===================== -->
 <div class='face'>
  <div class='hd'>
   <div>
    <div class='kk'>Engineering Performance</div>
    <div class='tt'>Discipline Performance</div>
    <div class='sb'>Plan vs actual progress by discipline · sorted by variance, worst first</div>
   </div>
   <div class='hr'>
    <label for='doc-flip' class='btn'>" & _IcoDoc & "DOCUMENT MATURITY</label>
    <div class='chips'>
     <span><i style='background:" & _cGood & "'></i><b>" & _nOn & "</b> on plan</span>
     <span><i style='background:" & _cWarn & "'></i><b>" & _nMon & "</b> monitor</span>
     <span><i style='background:" & _cBad & "'></i><b>" & _nRisk & "</b> at risk</span>
    </div>
   </div>
  </div>

  <div class='grid th'>
   <div>Discipline</div><div class='pg'>Progress</div><div class='r'>Plan</div><div class='r'>Actual</div>
   <div style='padding-left:6px'>Variance</div><div class='r'>Earned MH</div><div class='ctr'>Status</div>
  </div>

  <div class='body'>" & _Rows & "</div>

  <div class='grid tot'>
   <div class='c-name'><span class='nm'>Engineering Total</span></div>
   <div class='c-prog'><div class='pb'><div class='pf' style='width:" & _TpA & "%;background:" & _cInk & "'></div><div class='pt' style='left:" & _TpP & "%'></div></div></div>
   <div class='c-num'>" & IF ( ISBLANK ( _TP ), "—", FORMAT ( _TP, "0.0%" ) ) & "</div>
   <div class='c-num'>" & IF ( ISBLANK ( _TA ), "—", FORMAT ( _TA, "0.0%" ) ) & "</div>
   <div class='c-var'><span style='color:" & _TCol & "'>" & _TVt & "</span></div>
   <div class='c-num'>" & FORMAT ( _TotMH, "#,##0" ) & "</div>
   <div class='c-st'><span class='st'><i style='background:" & _TCol & "'></i>" & _TStat & "</span></div>
  </div>

  <div class='foot'>
   <span><i class='lgp'></i>Actual progress · tick = plan</span>
   <span>Status: on plan &ge; 0 · monitor to " & FORMAT ( _VarWatch * 100, "0.0" ) & " pts · at risk below</span>
  </div>
 </div>

 <!-- ===================== BACK · DOCUMENT MATURITY ===================== -->
 <div class='face back'>
  <div class='hd'>
   <div>
    <div class='kk'>Engineering Document Control</div>
    <div class='tt'>Document Maturity</div>
    <div class='sb'>Current document status distribution and progression to IFC</div>
   </div>
   <div class='hr'>
    <label for='doc-flip' class='btn'>" & _IcoGrid & "DISCIPLINE PERFORMANCE</label>
   </div>
  </div>

  <div class='hero'>
   <div>
    <div class='hv'>" & FORMAT ( _Tot, "#,##0" ) & "</div>
    <div class='hl'>Total documents</div>
   </div>
   <div>
    <div class='stack'>
     <b style='width:" & _pR & "%;background:" & _cIFR & "'></b>
     <b style='width:" & _pA2 & "%;background:" & _cIFA & "'></b>
     <b style='width:" & _pC & "%;background:" & _cIFC & "'></b>
     <b style='width:" & _pH & "%;background:" & _cWarn & "'></b>
    </div>
    <div class='lg'>
     <span><i style='background:" & _cIFR & "'></i>IFR " & _sIFR & "</span>
     <span><i style='background:" & _cIFA & "'></i>IFA " & _sIFA & "</span>
     <span><i style='background:" & _cIFC & "'></i>IFC " & _sIFC & "</span>
     <span><i style='background:" & _cWarn & "'></i>On hold " & _sHold & "</span>
    </div>
   </div>
   <div class='mat'>
    <div class='hv'>" & _sMat & "</div>
    <div class='hl'>Weighted maturity</div>
    <div class='mbar'><div style='width:" & _pMat & "%'></div></div>
   </div>
  </div>

  <div class='pipe'>
   <div class='stg'>
    <div class='sh'><span class='code'><i style='background:" & _cIFR & "'></i>IFR</span><span class='shr'>share</span></div>
    <div class='mid'><div><div class='num'>" & FORMAT ( _IFR, "#,##0" ) & "</div><div class='cap'>Issued for Review</div></div><svg class='ring' viewBox='0 0 56 56'><circle cx='28' cy='28' r='22' class='rt'/><circle cx='28' cy='28' r='22' pathLength='100' fill='none' stroke='" & _cIFR & "' stroke-width='6' stroke-linecap='round' stroke-dasharray='" & _pR & " 100' transform='rotate(-90 28 28)'/><text x='28' y='31.5'>" & _sIFR & "</text></svg></div>
    <div class='reach'><span>Reached &ge; IFR</span><b>" & _gIFR & "</b></div>
   </div>
   <div class='arw'>" & _IcoArr & "</div>
   <div class='stg'>
    <div class='sh'><span class='code'><i style='background:" & _cIFA & "'></i>IFA</span><span class='shr'>share</span></div>
    <div class='mid'><div><div class='num'>" & FORMAT ( _IFA, "#,##0" ) & "</div><div class='cap'>Issued for Approval</div></div><svg class='ring' viewBox='0 0 56 56'><circle cx='28' cy='28' r='22' class='rt'/><circle cx='28' cy='28' r='22' pathLength='100' fill='none' stroke='" & _cIFA & "' stroke-width='6' stroke-linecap='round' stroke-dasharray='" & _pA2 & " 100' transform='rotate(-90 28 28)'/><text x='28' y='31.5'>" & _sIFA & "</text></svg></div>
    <div class='reach'><span>Reached &ge; IFA</span><b>" & _gIFA & "</b></div>
   </div>
   <div class='arw'>" & _IcoArr & "</div>
   <div class='stg'>
    <div class='sh'><span class='code'><i style='background:" & _cIFC & "'></i>IFC</span><span class='shr'>share</span></div>
    <div class='mid'><div><div class='num'>" & FORMAT ( _IFC, "#,##0" ) & "</div><div class='cap'>Issued for Construction</div></div><svg class='ring' viewBox='0 0 56 56'><circle cx='28' cy='28' r='22' class='rt'/><circle cx='28' cy='28' r='22' pathLength='100' fill='none' stroke='" & _cIFC & "' stroke-width='6' stroke-linecap='round' stroke-dasharray='" & _pC & " 100' transform='rotate(-90 28 28)'/><text x='28' y='31.5'>" & _sIFC & "</text></svg></div>
    <div class='reach'><span>Construction ready</span><b>" & _sIFC & "</b></div>
   </div>
   <div class='sep'></div>
   <div class='stg'>
    <div class='sh'><span class='code'><i style='background:" & _cWarn & "'></i>ON HOLD</span><span class='shr'>share</span></div>
    <div class='mid'><div><div class='num'>" & FORMAT ( _OnHold, "#,##0" ) & "</div><div class='cap'>Progression suspended</div></div><svg class='ring' viewBox='0 0 56 56'><circle cx='28' cy='28' r='22' class='rt'/><circle cx='28' cy='28' r='22' pathLength='100' fill='none' stroke='" & _cWarn & "' stroke-width='6' stroke-linecap='round' stroke-dasharray='" & _pH & " 100' transform='rotate(-90 28 28)'/><text x='28' y='31.5'>" & _sHold & "</text></svg></div>
    <div class='reach'><span>Excluded from flow</span><b>" & FORMAT ( _OnHold, "#,##0" ) & "</b></div>
   </div>
  </div>

  <div class='nar'><b>INSIGHT</b>" & _DocNarr & "</div>
 </div>

</div>
</div>"
