Page_Header_HTML Engineering Progress =
/* =====================================================================
   PMIS PAGE HEADER  ·  HTML Content visual (58 px strip)
   ---------------------------------------------------------------------
   Left    : breadcrumb (system › module) + page title + report cycle tag
   Right   : cut-off date & ISO week · data freshness (days since cut-off)
             · Quick Insight button
   Style   : monochrome report · RAG colour only as status accent
   ===================================================================== */

-- 1. CONFIG ---------------------------------------------------------------
VAR _CutOff     = DATE ( 2025, 4, 20 )          -- or a measure, e.g. [Cut-Off Date]
VAR _Module     = "EPC Progress"
VAR _Section    = "Engineering"
VAR _PageTitle  = "Engineering Progress & Performance"
VAR _Cycle      = "Weekly Report"
VAR _FreshDays  = 7                              -- ≤ 7 days since cut-off = current
VAR _StaleDays  = 14                             -- > 14 days = stale

-- 2. PALETTE --------------------------------------------------------------
VAR _cInk   = "#1C3A5E"
VAR _cNavy  = "#243761"
VAR _cText  = "#6B7785"
VAR _cMuted = "#9AA3AD"
VAR _cLine  = "#E6EBF1"
VAR _cSoft  = "#F6F8FB"
VAR _cGood  = "#0F9B80"
VAR _cWarn  = "#E39016"
VAR _cBad   = "#D65365"

-- 3. REPORT CYCLE & DATA FRESHNESS ---------------------------------------
VAR _Today   = TODAY ()
VAR _Age     = INT ( _Today - _CutOff )
VAR _Week    = WEEKNUM ( _CutOff, 21 )          -- ISO week
VAR _cFresh  = IF ( _Age <= _FreshDays, _cGood, IF ( _Age <= _StaleDays, _cWarn, _cBad ) )
VAR _sFresh  = IF ( _Age <= _FreshDays, "Data current", IF ( _Age <= _StaleDays, "Update due", "Data stale" ) )
VAR _sAge    = FORMAT ( _Age, "#,##0" ) & IF ( _Age = 1, " day", " days" ) & " since cut-off"

-- 4. ICONS ----------------------------------------------------------------
VAR _iCal   = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='5' width='18' height='16' rx='2'/><path d='M3 10h18'/><path d='M8 3v4'/><path d='M16 3v4'/></svg>"
VAR _iChart = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.9' stroke-linecap='round' stroke-linejoin='round'><path d='M4 19V9'/><path d='M10 19V5'/><path d='M16 19v-7'/><path d='M22 19H2'/></svg>"
VAR _iArrow = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12h14'/><path d='M13 6l6 6-6 6'/></svg>"
VAR _iChev  = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M9 6l6 6-6 6'/></svg>"

-- 5. HTML -----------------------------------------------------------------
RETURN
"<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;height:100%;overflow:hidden;background:transparent!important;font-family:'Segoe UI',Arial,sans-serif;font-variant-numeric:tabular-nums}
.hd{position:relative;display:flex;align-items:center;gap:18px;width:100%;height:58px;padding:0 6px 0 12px;background:#FFFFFF;border-bottom:1px solid " & _cLine & "}
.hd:after{content:'';position:absolute;left:12px;bottom:-1px;width:44px;height:2px;border-radius:2px;background:" & _cNavy & "}

/* left : context */
.lf{min-width:0;flex:0 1 auto}
.crumb{display:flex;align-items:center;gap:5px;font-size:7.5px;font-weight:700;letter-spacing:.14em;color:" & _cMuted & ";text-transform:uppercase;white-space:nowrap}
.crumb svg{width:8px;height:8px;color:#C3CBD5}
.crumb b{color:" & _cNavy & "}
.ttl{display:flex;align-items:center;gap:9px;margin-top:5px}
.ttl h1{font-size:18px;line-height:1;font-weight:700;letter-spacing:-.02em;color:" & _cInk & ";white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tag{flex-shrink:0;height:18px;padding:0 8px;display:inline-flex;align-items:center;border-radius:999px;background:" & _cSoft & ";border:1px solid " & _cLine & ";font-size:7.5px;font-weight:700;letter-spacing:.06em;color:" & _cText & ";white-space:nowrap}

/* right : cycle + freshness */
.cy{margin-left:auto;display:flex;align-items:center;gap:10px;padding:0 16px 0 4px;height:40px}
.cal{width:32px;height:32px;flex-shrink:0;border-radius:9px;border:1px solid " & _cLine & ";background:#FFFFFF;display:flex;align-items:center;justify-content:center;color:" & _cInk & "}
.cal svg{width:16px;height:16px}
.cv{font-size:11px;font-weight:700;color:" & _cInk & ";white-space:nowrap}
.cv span{font-weight:600;color:" & _cText & "}
.fr{display:flex;align-items:center;gap:5px;margin-top:4px;font-size:7.5px;color:" & _cMuted & ";white-space:nowrap}
.fr b{display:inline-flex;align-items:center;gap:4px;height:14px;padding:0 6px;border-radius:999px;background:#F4F6F9;border:1px solid " & _cLine & ";font-size:7px;font-weight:700;letter-spacing:.05em;color:" & _cInk & "}
.fr b i{width:5px;height:5px;border-radius:50%;display:inline-block}

/* quick insight */
.qi{flex-shrink:0;display:flex;align-items:center;gap:9px;height:38px;padding:0 12px 0 6px;border-radius:10px;background:" & _cNavy & ";color:#FFFFFF;cursor:pointer;box-shadow:0 4px 12px rgba(36,55,97,.22);transition:transform .18s ease,box-shadow .18s ease}
.qi:hover{transform:translateY(-1px);box-shadow:0 7px 16px rgba(36,55,97,.28)}
.qi .ic{width:26px;height:26px;border-radius:7px;background:rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center}
.qi .ic svg{width:14px;height:14px}
.ql{font-size:8px;font-weight:700;letter-spacing:.09em}
.qs{margin-top:3px;font-size:7px;color:rgba(255,255,255,.65)}
.qa{display:flex;color:rgba(255,255,255,.8);transition:transform .18s ease}.qa svg{width:13px;height:13px}
.qi:hover .qa{transform:translateX(2px)}

@media(max-width:1050px){.tag{display:none}.qs{display:none}}
</style>

<div class='hd'>

 <div class='lf'>
  <div class='crumb'>PMIS" & _iChev & _Module & _iChev & "<b>" & _Section & "</b></div>
  <div class='ttl'><h1>" & SUBSTITUTE ( _PageTitle, "&", "&amp;" ) & "</h1><span class='tag'>" & _Cycle & " · W" & FORMAT ( _Week, "00" ) & "</span></div>
 </div>

 <div class='cy'>
  <div class='cal'>" & _iCal & "</div>
  <div>
   <div class='cv'>Cut-off " & FORMAT ( _CutOff, "dd mmm yyyy" ) & " <span>· Week " & FORMAT ( _Week, "00" ) & "</span></div>
   <div class='fr'><b><i style='background:" & _cFresh & "'></i>" & _sFresh & "</b>" & _sAge & "</div>
  </div>
 </div>

 <div class='qi'>
  <div class='ic'>" & _iChart & "</div>
  <div><div class='ql'>QUICK INSIGHT</div><div class='qs'>Executive view</div></div>
  <span class='qa'>" & _iArrow & "</span>
 </div>

</div>"
